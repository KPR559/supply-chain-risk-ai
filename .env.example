# ---- Shipment Delay Prediction - Frankfurt -> India prototype ----
# Copy to `.env` and adjust. All values are optional (see defaults in backend/core/config.py).

APP_ENV=development
LOG_LEVEL=INFO

# Storage
DATA_DIR=data
ARTIFACT_DIR=artifacts
# DuckDB warehouse file (relative to DATA_DIR unless absolute)
DUCKDB_PATH=warehouse.duckdb

# Monte Carlo simulation
MC_SIMULATIONS=10000
MC_SEED=42

# Delay semantics
DELAY_THRESHOLD_HOURS=24

# Conflict proximity decay (days half-life)
CONFLICT_DECAY_HALF_LIFE_DAYS=30

# Graph backend (networkx | neo4j)
GRAPH_BACKEND=networkx
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# GAT graph-residual training epochs (requires torch, see requirements-dev.txt)
GAT_EPOCHS=40

# NLP engine (local rule-based | llm/auto)
NLP_ENGINE=local
LLM_API_KEY=

# Demo / prediction seeds
DEMO_SEED=7

# Auth (default admin seeded into the DuckDB users table on first login)
AUTH_USER=admin
AUTH_PASS=admin123

# API server
API_HOST=0.0.0.0
API_PORT=8000