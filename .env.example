# ---- Shipment Delay Prediction - Frankfurt -> India prototype ----
# Copy to `.env` and adjust. All values are optional (see defaults in backend/core/config.py).

APP_ENV=development
LOG_LEVEL=INFO

# Storage
DATA_DIR=data
ARTIFACT_DIR=artifacts
# DuckDB warehouse file (relative to DATA_DIR unless absolute)
DUCKDB_PATH=warehouse.duckdb

# Monte Carlo simulation
MC_SIMULATIONS=10000
MC_SEED=42

# Delay semantics
DELAY_THRESHOLD_HOURS=24

# Conflict proximity decay (days half-life)
CONFLICT_DECAY_HALF_LIFE_DAYS=30

# Graph backend (networkx | neo4j)
GRAPH_BACKEND=networkx
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# GAT graph-residual training epochs (requires torch, see requirements-dev.txt)
GAT_EPOCHS=40

# NLP engine (local rule-based | llm/auto)
NLP_ENGINE=local
LLM_API_KEY=

# LLM provider (used by core/llm.py — Ollama exposed at localhost:11434)
# `llama3.2:latest` is a local default; install with `ollama pull llama3.2`
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:latest
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# Demo / prediction seeds
DEMO_SEED=7

# Auth (default admin seeded into the DuckDB users table on first login)
AUTH_USER=admin
AUTH_PASS=admin123
# JWT secret — MUST be overridden in production (e.g. `openssl rand -hex 32`)
AUTH_SECRET=dev-secret-change-in-production
AUTH_ACCESS_TTL_MIN=15
AUTH_REFRESH_TTL_DAYS=7
AUTH_RESET_TTL_MIN=60

# CORS — comma-separated origins, or "*" for open (dev only)
CORS_ORIGINS=*

# API server
API_HOST=0.0.0.0
API_PORT=8000